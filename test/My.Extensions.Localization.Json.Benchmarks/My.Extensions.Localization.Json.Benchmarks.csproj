<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net10.0</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" />
		<PackageReference Include="My.Extensions.Localization.Json" VersionOverride="$(JsonLocalizationVersion)" Condition="'$(JsonLocalizationVersion)' != ''" />
	</ItemGroup>

	<ItemGroup Condition="'$(JsonLocalizationVersion)' == ''">
		<ProjectReference Include="..\..\src\My.Extensions.Localization.Json\My.Extensions.Localization.Json.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(JsonLocalizationVersion)' != ''">
		<Compile Remove="JsonResourceLoaderBenchmark.cs;JsonResourceManagerBenchmark.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Resources\Big.fr-FR.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Resources\fr.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Resources\fr-FR.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Resources\Small.fr-FR.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
